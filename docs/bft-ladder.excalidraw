   "updated": 1790856000000,
   "link": null,
   "locked": false,
   "text": "Down the ladder: first block of a unit = number x size.   Day 6,732 starts at 6,732 x 144 = 969,408 and ends at 969,551.",
   "originalText": "Down the ladder: first block of a unit = number x size.   Day 6,732 starts at 6,732 x 144 = 969,408 and ends at 969,551.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 16
  },
  {
