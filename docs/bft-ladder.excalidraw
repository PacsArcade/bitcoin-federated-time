   "isDeleted": false,
   "boundElements": null,
   "updated": 1790856000000,
   "link": null,
   "locked": false,
   "text": "Up the ladder: unit number = height // size.   969,505 // 144 = 6,732, so it is day 6,732 (0018.07.13).",
   "originalText": "Up the ladder: unit number = height // size.   969,505 // 144 = 6,732, so it is day 6,732 (0018.07.13).",
   "fontSize": 17,
