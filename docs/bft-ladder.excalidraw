   "link": null,
   "locked": false,
   "text": "Exact calendar inverse:  first block of (year, month, day) = year x 52,416 + (month-1) x 4,032 + (day-1) x 144.",
   "originalText": "Exact calendar inverse:  first block of (year, month, day) = year x 52,416 + (month-1) x 4,032 + (day-1) x 144.",
